{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "Astro docs": {
            "type": "remote",
            "url": "https://mcp.docs.astro.build/mcp"
        },
        "chrome-devtools": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "chrome-devtools-mcp@latest",
                "--slim",
                "--headless"
            ],
        }
    }
}